class Solution {
    int[][] tree;
    int[] prod;
    int[] nums;
    int k;

    public int[] resultArray(int[] nums, int k, int[][] queries) {
        this.nums = nums;
        this.k = k;

        int n = nums.length;
        tree = new int[4 * n][k];
        prod = new int[4 * n];

        build(1, 0, n - 1);

        int[] ans = new int[queries.length];

        for (int q = 0; q < queries.length; q++) {
            int index = queries[q][0];
            int value = queries[q][1];
            int start = queries[q][2];
            int x = queries[q][3];

            nums[index] = value;
            update(1, 0, n - 1, index);

            Node res = query(1, 0, n - 1, start, n - 1);
            ans[q] = res.cnt[x];
        }

        return ans;
    }

    void build(int node, int l, int r) {
        if (l == r) {
            int v = nums[l] % k;
            prod[node] = v;
            tree[node][v] = 1;
            return;
        }

        int mid = (l + r) / 2;
        build(node * 2, l, mid);
        build(node * 2 + 1, mid + 1, r);
        merge(node);
    }

    void update(int node, int l, int r, int index) {
        if (l == r) {
            for (int i = 0; i < k; i++) {
                tree[node][i] = 0;
            }

            int v = nums[index] % k;
            prod[node] = v;
            tree[node][v] = 1;
            return;
        }

        int mid = (l + r) / 2;

        if (index <= mid) {
            update(node * 2, l, mid, index);
        } else {
            update(node * 2 + 1, mid + 1, r, index);
        }

        merge(node);
    }

    void merge(int node) {
        int left = node * 2;
        int right = node * 2 + 1;

        int leftProd = prod[left];
        prod[node] = (leftProd * prod[right]) % k;

        for (int i = 0; i < k; i++) {
            tree[node][i] = tree[left][i];
        }

        for (int i = 0; i < k; i++) {
            int rem = (leftProd * i) % k;
            tree[node][rem] += tree[right][i];
        }
    }

    Node query(int node, int l, int r, int ql, int qr) {
        if (ql <= l && r <= qr) {
            return new Node(prod[node], tree[node]);
        }

        int mid = (l + r) / 2;

        if (qr <= mid) {
            return query(node * 2, l, mid, ql, qr);
        }

        if (ql > mid) {
            return query(node * 2 + 1, mid + 1, r, ql, qr);
        }

        Node a = query(node * 2, l, mid, ql, qr);
        Node b = query(node * 2 + 1, mid + 1, r, ql, qr);

        int[] cnt = new int[k];

        for (int i = 0; i < k; i++) {
            cnt[i] = a.cnt[i];
        }

        for (int i = 0; i < k; i++) {
            int rem = (a.prod * i) % k;
            cnt[rem] += b.cnt[i];
        }

        return new Node((a.prod * b.prod) % k, cnt);
    }

    static class Node {
        int prod;
        int[] cnt;

        Node(int prod, int[] cnt) {
            this.prod = prod;
            this.cnt = cnt;
        }
    }
}
