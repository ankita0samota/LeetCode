class Solution {
    public String removeDuplicates(String s, int k) {
        char[] chars = s.toCharArray();
        int[] count = new int[chars.length];
        int size = 0;

        for (char c : chars) {
            chars[size] = c;

            if (size > 0 && chars[size - 1] == c) {
                count[size] = count[size - 1] + 1;
            } else {
                count[size] = 1;
            }

            if (count[size] == k) {
                size -= k - 1;
            } else {
                size++;
            }
        }

        return new String(chars, 0, size);
    }
}
