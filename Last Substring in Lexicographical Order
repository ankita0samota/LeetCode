class Solution {
    public String lastSubstring(String s) {
        int i = 0;
        int j = 1;
        int k = 0;
        int n = s.length();

        while (j + k < n) {
            char charI = s.charAt(i + k);
            char charJ = s.charAt(j + k);

            if (charI == charJ) {
                // Characters match, expand the matching window
                k++;
            } else if (charI > charJ) {
                // Suffix starting at i is larger so far. Skip checked characters for j.
                j = j + k + 1;
                k = 0;
            } else {
                // Suffix starting at j is larger. Skip checked characters for i.
                // i catches up to max(i + k + 1, j) to avoid reprocessing.
                i = Math.max(i + k + 1, j);
                j = i + 1;
                k = 0;
            }
        }
        
        return s.substring(i);
    }
}
