class Solution {
    public ListNode[] splitListToParts(ListNode head, int k) {
        int n = 0;
        ListNode curr = head;

        while (curr != null) {
            n++;
            curr = curr.next;
        }

        int size = n / k;
        int extra = n % k;

        ListNode[] ans = new ListNode[k];
        curr = head;

        for (int i = 0; i < k; i++) {
            ans[i] = curr;

            int partSize = size + (extra > 0 ? 1 : 0);
            extra--;

            for (int j = 1; j < partSize && curr != null; j++) {
                curr = curr.next;
            }

            if (curr != null) {
                ListNode next = curr.next;
                curr.next = null;
                curr = next;
            }
        }

        return ans;
    }
}
