public class Solution {
    public int maxLength(int[] nums) {
        int n = nums.length;
        int maxLen = 1;

        for (int i = 0; i < n; i++) {
            long prod = 1;
            int g = 0;
            long l = 1;

            for (int j = i; j < n; j++) {
                int x = nums[j];
                if (prod > Long.MAX_VALUE / x) {
                    break;
                }
                prod *= x;
                g = (j == i) ? x : gcd(g, x);
                l = lcm(l, x);

                if (prod == (long) g * l) {
                    maxLen = Math.max(maxLen, j - i + 1);
                }
            }
        }

        return maxLen;
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int t = a % b;
            a = b;
            b = t;
        }
        return a;
    }

    private long gcd(long a, long b) {
        while (b != 0) {
            long t = a % b;
            a = b;
            b = t;
        }
        return a;
    }

    private long lcm(long a, long b) {
        return (a / gcd(a, b)) * b;
    }
}
