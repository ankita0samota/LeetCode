import java.util.*;

public class Solution {
    public boolean canDistribute(int[] nums, int[] quantity) {
        Map<Integer, Integer> countMap = new HashMap<>();
        for (int num : nums) {
            countMap.put(num, countMap.getOrDefault(num, 0) + 1);
        }
        
        int m = countMap.size();
        int[] counts = new int[m];
        int idx = 0;
        for (int val : countMap.values()) {
            counts[idx++] = val;
        }
        
        int n = quantity.length;
        Integer[] q = new Integer[n];
        for (int i = 0; i < n; i++) q[i] = quantity[i];
        Arrays.sort(q, (a, b) -> Integer.compare(b, a));
        
        int totalMasks = 1 << n;
        int[] sumSubset = new int[totalMasks];
        for (int mask = 0; mask < totalMasks; mask++) {
            int sum = 0;
            for (int i = 0; i < n; i++) {
                if ((mask & (1 << i)) != 0) {
                    sum += q[i];
                }
            }
            sumSubset[mask] = sum;
        }
        
        boolean[][] dp = new boolean[m + 1][totalMasks];
        dp[0][0] = true;
        
        for (int i = 1; i <= m; i++) {
            int count = counts[i - 1];
            for (int mask = 0; mask < totalMasks; mask++) {
                dp[i][mask] = dp[i - 1][mask];
                if (dp[i][mask]) continue;
                
                for (int submask = mask; submask > 0; submask = (submask - 1) & mask) {
                    if (sumSubset[submask] <= count && dp[i - 1][mask ^ submask]) {
                        dp[i][mask] = true;
                        break;
                    }
                }
            }
        }
        
        return dp[m][totalMasks - 1];
    }
}
