import java.util.*;

class Solution {
    public int maxSum(List<Integer> nums, int k) {
        int[] count = new int[31];

        for (int x : nums) {
            for (int bit = 0; bit < 31; bit++) {
                if ((x & (1 << bit)) != 0) {
                    count[bit]++;
                }
            }
        }

        long ans = 0;
        long mod = 1_000_000_007;

        for (int i = 0; i < k; i++) {
            long x = 0;

            for (int bit = 30; bit >= 0; bit--) {
                if (count[bit] > 0) {
                    x |= (1L << bit);
                    count[bit]--;
                }
            }

            ans = (ans + x * x) % mod;
        }

        return (int) ans;
    }
}
