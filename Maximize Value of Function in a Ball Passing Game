import java.util.List;

public class Solution {
    public long getMaxFunctionValue(List<Integer> receiver, long k) {
        int n = receiver.size();
        int maxBits = 35; // k <= 10^10 < 2^34

        int[][] up = new int[n][maxBits];
        long[][] sum = new long[n][maxBits];

        // sum[x][j] = sum of the 2^j nodes visited starting at x (excluding the final landing node)
        for (int i = 0; i < n; i++) {
            up[i][0] = receiver.get(i);
            sum[i][0] = i;
        }

        for (int j = 1; j < maxBits; j++) {
            for (int i = 0; i < n; i++) {
                int mid = up[i][j - 1];
                up[i][j] = up[mid][j - 1];
                sum[i][j] = sum[i][j - 1] + sum[mid][j - 1];
            }
        }

        long ans = 0;
        for (int start = 0; start < n; start++) {
            int curr = start;
            long total = 0;
            for (int j = 0; j < maxBits; j++) {
                if (((k >> j) & 1L) != 0) {
                    total += sum[curr][j];
                    curr = up[curr][j];
                }
            }
            total += curr; // add the final player holding the ball after k passes
            ans = Math.max(ans, total);
        }

        return ans;
    }
}
