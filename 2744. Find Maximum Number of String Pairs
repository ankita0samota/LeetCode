class Solution {
    public int maximumNumberOfStringPairs(String[] words) {
          int count = 0;
        int length = words.length;

        for(int i =0; i<length-1; i++){
            for(int j = i+1; j<length; j++){
               if(words[i].charAt(0) == words[j].charAt(1)   &&   words[i].charAt(1) == words[j].charAt(0)){
                count ++;
               }
            }
        }
        return count;

    }
}