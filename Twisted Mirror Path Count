public class Solution {
    public int uniquePaths(int[][] grid) {
        int MOD = 1000000007;
        int m = grid.length, n = grid[0].length;
        int[][] dp = new int[n + 1][2];
        dp[1][0] = 1;
        dp[1][1] = 1;
        for (int r = 0; r < m; r++) {
            for (int c = 0; c < n; c++) {
                int next0, next1;
                if (grid[r][c] == 1) {
                    next0 = dp[c + 1][1];
                    next1 = dp[c][0];
                } else {
                    int val = (dp[c + 1][1] + dp[c][0]) % MOD;
                    next0 = val;
                    next1 = val;
                }
                dp[c + 1][0] = next0;
                dp[c + 1][1] = next1;
            }
        }
        return dp[n][0];
    }
}
