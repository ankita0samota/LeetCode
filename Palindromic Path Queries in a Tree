import java.util.*;

public class Solution {
    List<Integer>[] adj;
    int[] head, parent, depth, heavy, pos, nodeAtPos;
    int timer;
    int[] tree;
    int[] charMask;
    int n;

    public List<Boolean> palindromePath(int n, int[][] edges, String s, String[] queries) {
        this.n = n;
        adj = new ArrayList[n];
        for (int i = 0; i < n; i++) adj[i] = new ArrayList<>();
        for (int[] e : edges) {
            adj[e[0]].add(e[1]);
            adj[e[1]].add(e[0]);
        }

        head = new int[n];
        parent = new int[n];
        depth = new int[n];
        heavy = new int[n];
        pos = new int[n];
        nodeAtPos = new int[n];
        charMask = new int[n];
        tree = new int[4 * n];

        for (int i = 0; i < n; i++) {
            charMask[i] = 1 << (s.charAt(i) - 'a');
            heavy[i] = -1;
        }

        dfs1(0, -1, 0);
        timer = 0;
        dfs2(0, 0);

        build(1, 0, n - 1);

        List<Boolean> ans = new ArrayList<>();
        for (String q : queries) {
            int space1 = q.indexOf(' ');
            if (q.startsWith("update")) {
                int space2 = q.indexOf(' ', space1 + 1);
                int u = Integer.parseInt(q.substring(space1 + 1, space2));
                int c = q.charAt(space2 + 1) - 'a';
                int newMask = 1 << c;
                charMask[u] = newMask;
                update(1, 0, n - 1, pos[u], newMask);
            } else {
                int space2 = q.indexOf(' ', space1 + 1);
                int u = Integer.parseInt(q.substring(space1 + 1, space2));
                int v = Integer.parseInt(q.substring(space2 + 1));
                int mask = queryPath(u, v);
                ans.add(mask == 0 || (mask & (mask - 1)) == 0);
            }
        }
        return ans;
    }

    private int dfs1(int u, int p, int d) {
        parent[u] = p;
        depth[u] = d;
        int size = 1;
        int maxSubtree = 0;
        for (int v : adj[u]) {
            if (v != p) {
                int subtree = dfs1(v, u, d + 1);
                size += subtree;
                if (subtree > maxSubtree) {
                    maxSubtree = subtree;
                    heavy[u] = v;
                }
            }
        }
        return size;
    }

    private void dfs2(int u, int h) {
        head[u] = h;
        pos[u] = timer;
        nodeAtPos[timer] = u;
        timer++;
        if (heavy[u] != -1) {
            dfs2(heavy[u], h);
        }
        for (int v : adj[u]) {
            if (v != parent[u] && v != heavy[u]) {
                dfs2(v, v);
            }
        }
    }

    private void build(int node, int l, int r) {
        if (l == r) {
            tree[node] = charMask[nodeAtPos[l]];
            return;
        }
        int mid = (l + r) / 2;
        build(2 * node, l, mid);
        build(2 * node + 1, mid + 1, r);
        tree[node] = tree[2 * node] ^ tree[2 * node + 1];
    }

    private void update(int node, int l, int r, int idx, int val) {
        if (l == r) {
            tree[node] = val;
            return;
        }
        int mid = (l + r) / 2;
        if (idx <= mid) update(2 * node, l, mid, idx, val);
        else update(2 * node + 1, mid + 1, r, idx, val);
        tree[node] = tree[2 * node] ^ tree[2 * node + 1];
    }

    private int query(int node, int l, int r, int ql, int qr) {
        if (qr < l || ql > r) return 0;
        if (ql <= l && r <= qr) return tree[node];
        int mid = (l + r) / 2;
        return query(2 * node, l, mid, ql, qr) ^ query(2 * node + 1, mid + 1, r, ql, qr);
    }

    private int queryPath(int u, int v) {
        int res = 0;
        while (head[u] != head[v]) {
            if (depth[head[u]] > depth[head[v]]) {
                int temp = u;
                u = v;
                v = temp;
            }
            res ^= query(1, 0, n - 1, pos[head[v]], pos[v]);
            v = parent[head[v]];
        }
        if (depth[u] > depth[v]) {
            int temp = u;
            u = v;
            v = temp;
        }
        res ^= query(1, 0, n - 1, pos[u], pos[v]);
        return res;
    }
}
