import java.util.ArrayDeque;
import java.util.Deque;

public class Solution {
    public int boxDelivering(int[][] boxes, int portsCount, int maxBoxes, int maxWeight) {
        int n = boxes.length;
        int[] p = new int[n + 1];
        long[] w = new long[n + 1];
        int[] neg = new int[n + 1];
        
        for (int i = 0; i < n; i++) {
            p[i + 1] = boxes[i][0];
            w[i + 1] = boxes[i][1];
        }
        
        for (int i = 1; i <= n; i++) {
            w[i] += w[i - 1];
            neg[i] = neg[i - 1] + (i > 1 && p[i] != p[i - 1] ? 1 : 0);
        }
        
        int[] dp = new int[n + 1];
        Deque<Integer> q = new ArrayDeque<>();
        q.offer(0);
        
        for (int i = 1; i <= n; i++) {
            while (!q.isEmpty() && (i - q.peekFirst() > maxBoxes || w[i] - w[q.peekFirst()] > maxWeight)) {
                q.pollFirst();
            }
            
            dp[i] = dp[q.peekFirst()] + neg[i] - neg[q.peekFirst()] + 2;
            
            if (i == n) {
                break;
            }
            
            while (!q.isEmpty() && dp[i] - neg[i + 1] <= dp[q.peekLast()] - neg[q.peekLast() + 1]) {
                q.pollLast();
            }
            q.offerLast(i);
        }
        
        return dp[n];
    }
}
