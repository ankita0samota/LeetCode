import java.util.*;

class Solution {
    public List<String> removeInvalidParentheses(String s) {
        List<String> ans = new ArrayList<>();
        backtrack(s, 0, 0, '(', ')', ans);
        return ans;
    }

    private void backtrack(String s, int start, int last, char open, char close, List<String> ans) {
        int balance = 0;

        for (int i = start; i < s.length(); i++) {
            if (s.charAt(i) == open) balance++;
            else if (s.charAt(i) == close) balance--;

            if (balance >= 0) continue;

            for (int j = last; j <= i; j++) {
                if (s.charAt(j) == close && (j == last || s.charAt(j - 1) != close)) {
                    backtrack(s.substring(0, j) + s.substring(j + 1),
                              i, j, open, close, ans);
                }
            }
            return;
        }

        String reversed = new StringBuilder(s).reverse().toString();

        if (open == '(') {
            backtrack(reversed, 0, 0, ')', '(', ans);
        } else {
            ans.add(reversed);
        }
    }
}
