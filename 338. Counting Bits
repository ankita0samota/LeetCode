class Solution {
    public int[] countBits(int n) {
        int[] ans=new int[n+1];
        for(int i=0;i<=n;i++){
            int cnt=0;
            for(int j=0;j<32;j++){
            if(((i>>j)&1)==1)
                cnt++;
            }
            ans[i]=cnt;
        }
        return ans;
    }
}