import java.util.HashSet;
import java.util.Set;

public class Solution {
    private static final long MOD1 = 1_000_000_007L;
    private static final long MOD2 = 1_000_000_009L;
    private static final long BASE1 = 1315423911L;
    private static final long BASE2 = 2654435761L;

    public int smallestUniqueSubarray(int[] nums) {
        int n = nums.length;
        long[] pow1 = new long[n + 1];
        long[] pow2 = new long[n + 1];
        long[] pref1 = new long[n + 1];
        long[] pref2 = new long[n + 1];

        pow1[0] = 1;
        pow2[0] = 1;

        for (int i = 0; i < n; i++) {
            long val = nums[i] + 1L;
            pow1[i + 1] = (pow1[i] * BASE1) % MOD1;
            pow2[i + 1] = (pow2[i] * BASE2) % MOD2;
            pref1[i + 1] = (pref1[i] * BASE1 + val) % MOD1;
            pref2[i + 1] = (pref2[i] * BASE2 + val) % MOD2;
        }

        int low = 1;
        int high = n;
        int ans = n;

        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (hasUniqueOfLength(mid, n, pow1, pow2, pref1, pref2)) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return ans;
    }

    private boolean hasUniqueOfLength(
            int len,
            int n,
            long[] pow1,
            long[] pow2,
            long[] pref1,
            long[] pref2
    ) {
        Set<Long> seenOnce = new HashSet<>();
        Set<Long> seenMultiple = new HashSet<>();

        for (int i = 0; i + len <= n; i++) {
            int j = i + len;
            long h1 = (pref1[j] - (pref1[i] * pow1[len]) % MOD1 + MOD1) % MOD1;
            long h2 = (pref2[j] - (pref2[i] * pow2[len]) % MOD2 + MOD2) % MOD2;
            long key = (h1 << 32) | (h2 & 0xffffffffL);

            if (seenMultiple.contains(key)) {
                continue;
            }
            if (!seenOnce.add(key)) {
                seenOnce.remove(key);
                seenMultiple.add(key);
            }
        }

        return !seenOnce.isEmpty();
    }
}
