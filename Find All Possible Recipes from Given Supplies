import java.util.*;

class Solution {
    public List<String> findAllRecipes(String[] recipes, List<List<String>> ingredients, String[] supplies) {
        Map<String, List<String>> graph = new HashMap<>();
        Map<String, Integer> need = new HashMap<>();
        Queue<String> queue = new LinkedList<>();
        
        for (String supply : supplies) {
            queue.offer(supply);
        }
        
        for (int i = 0; i < recipes.length; i++) {
            need.put(recipes[i], ingredients.get(i).size());
            
            for (String ingredient : ingredients.get(i)) {
                graph.computeIfAbsent(ingredient, k -> new ArrayList<>()).add(recipes[i]);
            }
        }
        
        List<String> ans = new ArrayList<>();
        
        while (!queue.isEmpty()) {
            String item = queue.poll();
            
            if (!graph.containsKey(item)) continue;
            
            for (String recipe : graph.get(item)) {
                need.put(recipe, need.get(recipe) - 1);
                
                if (need.get(recipe) == 0) {
                    ans.add(recipe);
                    queue.offer(recipe);
                }
            }
        }
        
        return ans;
    }
}
