class Solution {
    public int countHomogenous(String s) {
        long ans = 0;
        long count = 1;
        long mod = 1000000007L;

        for (int i = 1; i < s.length(); i++) {
            if (s.charAt(i) == s.charAt(i - 1)) {
                count++;
            } else {
                ans = (ans + count * (count + 1) / 2) % mod;
                count = 1;
            }
        }

        ans = (ans + count * (count + 1) / 2) % mod;

        return (int) ans;
    }
}
