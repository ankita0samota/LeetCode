class Solution {
    public int gcdOfOddEvenSums(int n) {
        int count1 = 0, count2 = 0;
        int sumOdd = 0, sumEven = 0;
        int i = 1;
        while (n > 0) {
            if (i % 2 == 0) {
                sumEven += i;
                count1++;
            } else {
                sumOdd += i;
                count2++;
            }
            i++;
            if (count1 == n && count2 == n) {
                break;
            }
        }
        while (sumEven > 0 && sumOdd > 0) {
            int digit = sumEven % sumOdd;
            sumEven = sumOdd;
            sumOdd = digit;
        }
        return sumEven;
    }
}